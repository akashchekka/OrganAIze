# ── LLM Provider ────────────────────────────
# LiteLLM auto-detects the provider from the model name.
# Just set the right API key for your chosen provider.

# Option 1: Azure OpenAI (default)
AZURE_API_KEY=your-azure-key
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-01
ORGANAIZE_DEFAULT_MODEL=azure/gpt-4o

# Option 2: OpenAI
# OPENAI_API_KEY=sk-your-openai-key
# ORGANAIZE_DEFAULT_MODEL=gpt-4o

# Option 3: Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key
# ORGANAIZE_DEFAULT_MODEL=claude-sonnet-4-20250514

# Option 4: Ollama (local, free)
# ORGANAIZE_LLM_API_BASE=http://localhost:11434
# ORGANAIZE_DEFAULT_MODEL=ollama/llama3

# Option 5: Any LiteLLM-supported provider
# See: https://docs.litellm.ai/docs/providers
# ORGANAIZE_LLM_API_KEY=your-key
# ORGANAIZE_LLM_API_BASE=https://your-endpoint
# ORGANAIZE_DEFAULT_MODEL=your-provider/model-name

# ── Agent Limits ────────────────────────────
ORGANAIZE_MAX_AGENTS=20
ORGANAIZE_MAX_DEPTH=4
ORGANAIZE_GENESIS_BUDGET=8
ORGANAIZE_MAX_CONCURRENT_LLM=3

# ── Token Limits ────────────────────────────
ORGANAIZE_MAX_SESSION_TOKENS=500000

# ── Defaults ───────────────────────────────────
ORGANAIZE_DEFAULT_MAX_STEPS=30

# ── Output ─────────────────────────────────────
# ORGANAIZE_OUTPUT_DIR=./output

# ── LangSmith (Observability) ──────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_your-langsmith-key
# LANGSMITH_PROJECT="OrganAIze"
