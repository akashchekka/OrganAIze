# ── LLM Provider ────────────────────────────
# LiteLLM auto-detects the provider from the model name.
# Just set the right API key for your chosen provider.

# Option 1: Azure OpenAI (default)
AZURE_API_KEY=your-azure-key
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-02-01
EVOLVE_DEFAULT_MODEL=azure/gpt-4o

# Option 2: OpenAI
# OPENAI_API_KEY=sk-your-openai-key
# EVOLVE_DEFAULT_MODEL=gpt-4o

# Option 3: Anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key
# EVOLVE_DEFAULT_MODEL=claude-sonnet-4-20250514

# Option 4: Ollama (local, free)
# EVOLVE_LLM_API_BASE=http://localhost:11434
# EVOLVE_DEFAULT_MODEL=ollama/llama3

# Option 5: Any LiteLLM-supported provider
# See: https://docs.litellm.ai/docs/providers
# EVOLVE_LLM_API_KEY=your-key
# EVOLVE_LLM_API_BASE=https://your-endpoint
# EVOLVE_DEFAULT_MODEL=your-provider/model-name

# ── MongoDB ─────────────────────────────────
EVOLVE_MONGO_URI=mongodb://localhost:27017
EVOLVE_MONGO_DB=evolve

# ── Redis ───────────────────────────────────
EVOLVE_REDIS_URL=redis://localhost:6379/0

# ── Object Storage ──────────────────────────
EVOLVE_OBJECT_STORE=local
EVOLVE_OBJECT_LOCAL_PATH=./artifacts
# EVOLVE_OBJECT_STORE=s3
# EVOLVE_OBJECT_BUCKET=evolve-artifacts

# ── Agent Limits ────────────────────────────
EVOLVE_MAX_AGENTS=20
EVOLVE_MAX_DEPTH=4
EVOLVE_GENESIS_BUDGET=8
EVOLVE_MAX_CONCURRENT_LLM=3

# ── Budget ──────────────────────────────────
EVOLVE_SESSION_BUDGET_USD=5.00

# ── Defaults ────────────────────────────────
EVOLVE_DEFAULT_TTL=300
EVOLVE_DEFAULT_MAX_STEPS=30
# EVOLVE_DEFAULT_MODEL is set in the LLM Provider section above
